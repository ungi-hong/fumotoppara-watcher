# LINE Messaging API（LINE Developers Console で取得）
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_access_token_here

# Firebase Admin SDK（Firebase Console → プロジェクト設定 → サービスアカウント → 新しい秘密鍵を生成）
# Vercel / GitHub Secrets の UI ではダウンロードした JSON をそのまま貼り付けてOK
# ローカルの .env ファイルで使う場合のみ1行に圧縮が必要:
#   jq -c . service-account.json | pbcopy  (macOS)
#   jq -c . service-account.json | clip    (Windows)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# cron-job.org（監視対象が0件のときジョブを自動で disable するために使用）
# API key: https://console.cron-job.org/settings → API
# JOB ID: ジョブ詳細URL https://console.cron-job.org/jobs/12345 の末尾の数字
CRONJOB_API_KEY=your_cronjob_api_key_here
CRONJOB_JOB_ID=12345
